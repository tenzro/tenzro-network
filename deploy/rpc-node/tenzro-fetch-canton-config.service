# /etc/systemd/system/tenzro-fetch-canton-config.service
#
# Installed on validator-0 (RPC node) only.
#
# Runs once on boot before tenzro-node.service, fetches Canton + admin
# secrets from the canton-network Secret Manager project, writes them
# to /etc/tenzro/ (root-only). Cross-project access via
# tenzro-validator-0@tenzro-operator-project.iam.gserviceaccount.com (already has
# cloud-platform scope; needs roles/secretmanager.secretAccessor on each
# of the three secrets in canton-network).
#
# Rotation: update Secret Manager → systemctl restart this unit → docker
# stop tenzro-node (systemd respawns tenzro-node with new values).

[Unit]
Description=Fetch Canton config + admin token from canton-network Secret Manager
After=network-online.target
Wants=network-online.target
Before=tenzro-node.service
RequiredBy=tenzro-node.service

[Service]
Type=oneshot
RemainAfterExit=yes
# COS mounts /var as noexec (verified `mount | grep /var` shows
# rw,nosuid,nodev,noexec). The script itself is 0755 but systemd cannot
# direct-exec it. Invoke via `bash <path>` so bash reads it as data,
# matching the existing tenzro-node.service + tenzro-fetch-keys.service
# pattern on the same VM.
ExecStart=/bin/bash /var/lib/tenzro-bin/fetch-canton-config

[Install]
WantedBy=multi-user.target
