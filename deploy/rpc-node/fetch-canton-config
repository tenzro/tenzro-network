#!/bin/bash
#
# Fetch Canton config + RPC operator admin token from the canton-network
# Secret Manager project, write them into /etc/tenzro/tenzro-node.env for
# tenzro-node.service to source via EnvironmentFile= on next start.
#
# Runs once on boot via tenzro-fetch-canton-config.service, before
# tenzro-node.service.
#
# Validator-0 (RPC node) only — installed on no other VM.
#
# Secrets read (in canton-network project):
#   - tenzro-rpc-admin-token                  → TENZRO_ADMIN_TOKEN
#   - damlstudio-canton-auth0-client-secret   → CANTON_DEVNET_CLIENT_SECRET
#
# The Auth0 client_secret is owned by damlstudio but grants the
# `daml_ledger_api` scope on the `https://canton.network.global`
# audience that Tenzro's CantonTokenProvider expects (verified 2026-05-31
# against https://json.devnet.tenzro.network/v2/version with a fresh token).
# Reused here to avoid duplicating an Auth0 client for one ledger endpoint.
#
# Why env-only (no TOML --config): NodeConfig::load_from_file expects the
# full schema; partial overlay isn't supported. CantonConfig::from_env
# already covers the devnet profile via CANTON_DEVNET=true +
# CANTON_DEVNET_CLIENT_SECRET, which is what we use here. CANTON_DEVNET
# is set statically by the wrapper; the secret comes from this file.
#
# Cross-project access: validator-0's SA
# (tenzro-validator-0@tenzro-infra.iam.gserviceaccount.com) has
# roles/secretmanager.secretAccessor granted per-secret on each of the
# two above. SA already carries the `cloud-platform` scope on the
# instance.
#
# COS-isms (see tenzro-fetch-keys for the same pattern):
#   - /var is mounted noexec, so the unit invokes us via `bash <path>`.
#   - No gcloud CLI; we hit the Secret Manager REST API directly using
#     the metadata-server access token.
#
# Rotation: update Secret Manager → systemctl restart this unit → docker
#           stop tenzro-node (systemd respawns with new values).

set -euo pipefail

PROJECT=canton-network
ETC=/etc/tenzro

TOKEN=$(curl -sS --fail \
  -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
  | python3 -c 'import sys, json; print(json.load(sys.stdin)["access_token"])')

fetch_secret() {
  local secret="$1"
  curl -sS --fail \
    -H "Authorization: Bearer $TOKEN" \
    -H 'Accept: application/json' \
    "https://secretmanager.googleapis.com/v1/projects/$PROJECT/secrets/$secret/versions/latest:access" \
    | python3 -c 'import sys, json, base64; sys.stdout.buffer.write(base64.b64decode(json.load(sys.stdin)["payload"]["data"]))'
}

ADMIN_TOKEN=$(fetch_secret tenzro-rpc-admin-token)
CANTON_CS=$(fetch_secret damlstudio-canton-auth0-client-secret)

install -d -m 0755 -o root -g root "$ETC"
umask 077

# systemd reads this as root via EnvironmentFile=, then the wrapper
# forwards both vars into the container via `-e VAR` (no `=value` makes
# docker pass-through whatever the environment has). 0600 root-only is
# fine — the container never reads this file directly.
cat > "$ETC/tenzro-node.env" <<EOF
TENZRO_ADMIN_TOKEN=$ADMIN_TOKEN
CANTON_DEVNET_CLIENT_SECRET=$CANTON_CS
EOF
chmod 0600 "$ETC/tenzro-node.env"
chown root:root "$ETC/tenzro-node.env"

echo "fetch-canton-config: wrote $ETC/tenzro-node.env (TENZRO_ADMIN_TOKEN + CANTON_DEVNET_CLIENT_SECRET)"
