# deploy/terraform/gce_validators/terraform.tfvars.example
#
# Copy to terraform.tfvars and edit before `terraform plan`.
# terraform.tfvars itself is .gitignore'd (it contains the live peer ID
# and may carry per-operator overrides); this .example file is the
# committed template.

# Required: peer ID of validator-0, copied verbatim from
# `PEER_IDS.txt` produced by `tools/genkeys/`. Without this, plan fails.
bootstrap_peer_id = "12D3KooW................................................"

# Image tag of a tenzro-node build that includes the #129 snapshot ABCI
# + /ready + graceful-exit + state-sync bootstrap code. Bump per rollout.
image_tag = "20260513-192247"

# All other variables have sensible defaults in variables.tf:
#   project_id           = "tenzro-operator-project"
#   primary_region       = "us-central1"
#   registry_host        = "us-central1-docker.pkg.dev"
#   image_repo           = "tenzro-operator-project/tenzro"
#   machine_type         = "n2-standard-4"
#   disk_size_gb         = 100
#   disk_type            = "pd-balanced"
#   validators           = [...10 entries across us-central1-{a,b,c}, us-east1-b, us-west1-a...]
#   genesis_toml_path    = "../../../config/genesis-prod.toml"
#
# Override any of them here if you need a different topology — but the
# default 10/5-zone layout is what Phase A targets and what the genesis
# file produced by tools/genkeys/ assumes.
