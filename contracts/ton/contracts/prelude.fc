;; SPDX-License-Identifier: Apache-2.0
;; The TVM primitives the bridge and the jetton wallet use, written out so
;; the contracts carry no external library.

cell get_data() asm "c4 PUSH";
() set_data(cell c) impure asm "c4 POP";
slice begin_parse(cell c) asm "CTOS";
builder begin_cell() asm "NEWC";
cell end_cell(builder b) asm "ENDC";
builder store_ref(builder b, cell c) asm(c b) "STREF";
builder store_slice(builder b, slice s) asm "STSLICER";
builder store_builder(builder to, builder from) asm "STBR";
builder store_coins(builder b, int x) asm "STVARUINT16";
builder store_dict(builder b, cell c) asm(c b) "STDICT";
(slice, int) load_coins(slice s) asm(-> 1 0) "LDVARUINT16";
(slice, slice) load_msg_addr(slice s) asm(-> 1 0) "LDMSGADDR";
(slice, cell) load_ref(slice s) asm(-> 1 0) "LDREF";
(slice, cell) load_dict(slice s) asm(-> 1 0) "LDDICT";
slice skip_bits(slice s, int len) asm "SDSKIPFIRST";
(slice, ()) ~skip_bits(slice s, int len) asm "SDSKIPFIRST";
int slice_bits(slice s) asm "SBITS";
int slice_refs(slice s) asm "SREFS";
int slice_empty?(slice s) asm "SEMPTY";
int equal_slices(slice a, slice b) asm "SDEQ";
int cell_hash(cell c) asm "HASHCU";
int min(int x, int y) asm "MIN";
(int, int) parse_std_addr(slice s) asm "REWRITESTDADDR";
cell udict_set(cell dict, int key_len, int index, slice value) asm(value index dict key_len) "DICTUSET";
(slice, int) udict_get_slice?(cell dict, int key_len, int index) asm(index dict key_len) "DICTUGET" "NULLSWAPIFNOT";
cell new_dict() asm "NEWDICT";
slice my_address() asm "MYADDR";
() send_raw_message(cell msg, int mode) impure asm "SENDRAWMSG";
(int, int, int, int) ecrecover(int hash, int v, int r, int s) asm "ECRECOVER" "NULLSWAPIFNOT2" "NULLSWAPIFNOT";
int keccak_1(slice a) asm "1 PUSHINT" "HASHEXT_KECCAK256";
int keccak_5(slice a, slice b, slice c, slice d, slice e) asm "5 PUSHINT" "HASHEXT_KECCAK256";
;; Keccak-256 of the concatenation of a tuple of slices (at most 255).
int keccak_tuple(tuple t) asm "255 PUSHINT" "EXPLODEVAR" "HASHEXT_KECCAK256";
cell preload_ref(slice s) asm "PLDREF";
int string_hash(slice s) asm "SHA256U";
int sha256_2(slice a, slice b) asm "2 PUSHINT" "HASHEXT_SHA256";
int sha256_5(slice a, slice b, slice c, slice d, slice e) asm "5 PUSHINT" "HASHEXT_SHA256";
slice bls_g1_add(slice x, slice y) asm "BLS_G1_ADD";
slice bls_g1_mul(slice x, int s) asm "BLS_G1_MUL";
slice bls_g1_neg(slice x) asm "BLS_G1_NEG";
int bls_pairing_check2(slice p1, slice q1, slice p2, slice q2) asm "2 PUSHINT" "x{F93030} s,";  ;; BLS_PAIRING_CHECK
int bls_pairing_check4(slice p1, slice q1, slice p2, slice q2, slice p3, slice q3, slice p4, slice q4) asm "4 PUSHINT" "x{F93030} s,";  ;; BLS_PAIRING_CHECK
int sha256_3(slice a, slice b, slice c) asm "3 PUSHINT" "HASHEXT_SHA256";
int sha256_4(slice a, slice b, slice c, slice d) asm "4 PUSHINT" "HASHEXT_SHA256";
int p256_check(int hash, slice signature, slice key) asm "P256_CHKSIGNU";
int slice_refs_empty?(slice s) asm "SREMPTY";
tuple empty_tuple() asm "NIL";
forall X -> (tuple, ()) ~tpush(tuple t, X value) asm "TPUSH";
int now() asm "NOW";
int tlen(tuple t) asm "TLEN";
forall X -> X null() asm "PUSHNULL";
