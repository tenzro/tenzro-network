{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "TenzroIdentity": {
      "@id": "https://ns.tenzro.xyz/v1#TenzroIdentity",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "id": "@id",
        "type": "@type",
        "identityType": "https://ns.tenzro.xyz/v1#identityType",
        "kycTier": "https://ns.tenzro.xyz/v1#kycTier",
        "controller": "https://www.w3.org/ns/did#controller",
        "controlledMachines": "https://ns.tenzro.xyz/v1#controlledMachines",
        "delegationScope": "https://ns.tenzro.xyz/v1#delegationScope",
        "tenzroAgentId": "https://ns.tenzro.xyz/v1#tenzroAgentId"
      }
    },

    "DelegationScope": {
      "@id": "https://ns.tenzro.xyz/v1#DelegationScope",
      "@context": {
        "@version": 1.1,
        "@protected": true,
        "maxTransactionValue": "https://ns.tenzro.xyz/v1#maxTransactionValue",
        "maxDailySpend": "https://ns.tenzro.xyz/v1#maxDailySpend",
        "allowedOperations": "https://ns.tenzro.xyz/v1#allowedOperations",
        "allowedContracts": "https://ns.tenzro.xyz/v1#allowedContracts",
        "timeBound": "https://ns.tenzro.xyz/v1#timeBound",
        "allowedPaymentProtocols": "https://ns.tenzro.xyz/v1#allowedPaymentProtocols",
        "allowedChains": "https://ns.tenzro.xyz/v1#allowedChains"
      }
    },

    "KycCredential": "https://ns.tenzro.xyz/v1#KycCredential",
    "CapabilityCredential": "https://ns.tenzro.xyz/v1#CapabilityCredential",
    "AttestationCredential": "https://ns.tenzro.xyz/v1#AttestationCredential",

    "kycTier": {
      "@id": "https://ns.tenzro.xyz/v1#kycTier",
      "@type": "https://ns.tenzro.xyz/v1#KycTier"
    },

    "capabilities": {
      "@id": "https://ns.tenzro.xyz/v1#capabilities",
      "@container": "@set"
    },

    "walletId": "https://ns.tenzro.xyz/v1#walletId",
    "tenzroDid": "https://ns.tenzro.xyz/v1#tenzroDid",
    "registrationFee": "https://ns.tenzro.xyz/v1#registrationFee",
    "reputation": "https://ns.tenzro.xyz/v1#reputation"
  }
}
