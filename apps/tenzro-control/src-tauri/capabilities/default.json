{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Tenzro Control main window: the app's own commands, the window controls the custom title bar uses, and the OS platform read. Plugins the Rust side drives (opener, dialog, store, deep-link, global-shortcut, window-state) are not exposed to the webview.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "os:allow-platform",
    "allow-scan-hardware",
    "allow-model-budget",
    "allow-get-config",
    "allow-pricing-brackets",
    "allow-set-roles",
    "allow-set-models",
    "allow-set-availability",
    "allow-set-ai-pricing",
    "allow-set-storage-pricing",
    "allow-set-compute-pricing",
    "allow-set-memory-config",
    "allow-complete-onboarding",
    "allow-node-status",
    "allow-restart-node",
    "allow-reset-local-chain",
    "allow-node-data-dir",
    "allow-reveal-data-dir",
    "allow-wallet-status",
    "allow-wallet-use-hardware-key",
    "allow-wallet-send",
    "allow-stake-bond",
    "allow-stake-unbond",
    "allow-stake-withdraw",
    "allow-model-details",
    "allow-download-progress",
    "allow-serve-model",
    "allow-stop-model",
    "allow-offload-model",
    "allow-forecast-catalog",
    "allow-forecast-list",
    "allow-forecast-load",
    "allow-forecast-unload",
    "allow-forecast-run",
    "allow-media-catalog",
    "allow-media-render",
    "allow-assistant-chat",
    "allow-assistant-cancel",
    "allow-rpc-call",
    "allow-device-create-passkey",
    "allow-device-sign-with-passkey",
    "allow-device-sign-hybrid-with-passkey",
    "allow-device-start-cross-device-link",
    "allow-device-complete-cross-device-link",
    "allow-device-cancel-cross-device-link"
  ]
}
