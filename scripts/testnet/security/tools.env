# Pinned versions of the security tools the supply-chain checks run. Change a version here and nowhere else.
CARGO_AUDIT_VERSION=0.22.2
CARGO_DENY_VERSION=0.20.2
CARGO_GEIGER_VERSION=0.13.0
CARGO_VET_VERSION=0.10.3
SEMGREP_VERSION=1.180.0
# Rust rules for Semgrep: the upstream rules repository at a fixed commit, cloned once into the tools folder and
# used offline. Its licence allows internal use; the rules are never copied into this repository.
SEMGREP_RULES_REPO=https://github.com/semgrep/semgrep-rules
SEMGREP_RULES_COMMIT=9bbf021d0acffa3095fcffd17b2bc7787eb4796d
# Miri ships only with nightly toolchains; this is the pinned one.
MIRI_NIGHTLY=nightly-2026-10-08
# osv-scanner: the release binary at a pinned version, checked against the release's SHA-256 before it is used.
OSV_SCANNER_VERSION=2.6.0
OSV_SCANNER_SHA256_linux_amd64=ca69b3d3cd08f889a49dc0a383122f71cc528b83803671df5fd874d97485b108
OSV_SCANNER_SHA256_linux_arm64=2c71403eb443d05891c4f268c3ad771cf4f16e5443463fd7851ef8f454d3c7e4
