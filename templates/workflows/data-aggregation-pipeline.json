{
  "name": "data-aggregation-pipeline",
  "version": "1.0.0",
  "description": "Query two knowledge sources on a topic, embed each with a text embedding model, archive the aggregated vectors to DA storage.",
  "category": "data",
  "capabilities": ["aggregation", "embedding", "storage"],
  "required_inputs": {
    "type": "object",
    "properties": {
      "topic": { "type": "string" },
      "news_source_id": {
        "type": "string",
        "description": "Registry id of a news knowledge base. Discover one with tenzro_listKnowledge."
      },
      "research_source_id": {
        "type": "string",
        "description": "Registry id of a research knowledge base. Discover one with tenzro_listKnowledge."
      }
    },
    "required": ["topic", "news_source_id", "research_source_id"]
  },
  "expected_outputs": {
    "type": "object",
    "properties": {
      "news": { "type": "object" },
      "research": { "type": "object" },
      "news_embedding": { "type": "object" },
      "research_embedding": { "type": "object" },
      "da_pointer": {
        "type": "object",
        "properties": {
          "tenzro_uri": { "type": "string" },
          "size_bytes": { "type": "integer" }
        }
      }
    }
  },
  "steps": [
    {
      "kind": "use_knowledge",
      "knowledge_id": "{{ inputs.news_source_id }}",
      "params": { "topic": "{{ inputs.topic }}" },
      "output_as": "news"
    },
    {
      "kind": "use_knowledge",
      "knowledge_id": "{{ inputs.research_source_id }}",
      "params": { "topic": "{{ inputs.topic }}" },
      "output_as": "research"
    },
    {
      "kind": "use_model",
      "model_id": "qwen3-embedding-0.6b",
      "params": { "input": "{{ steps.news.output }}" },
      "output_as": "news_embedding"
    },
    {
      "kind": "use_model",
      "model_id": "qwen3-embedding-0.6b",
      "params": { "input": "{{ steps.research.output }}" },
      "output_as": "research_embedding"
    },
    {
      "kind": "use_tool",
      "tool_id": "tool-da-publish",
      "tool_name": "publish_blob",
      "params": {
        "data": {
          "topic": "{{ inputs.topic }}",
          "embeddings": [
            "{{ steps.news_embedding.output }}",
            "{{ steps.research_embedding.output }}"
          ]
        }
      },
      "output_as": "da_pointer"
    }
  ]
}
