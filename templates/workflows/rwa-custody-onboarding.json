{
  "name": "rwa-custody-onboarding",
  "version": "1.0.0",
  "description": "Tokenized real-world-asset custody onboarding: KYC knowledge query → identity registration → custody MPC bind.",
  "category": "rwa",
  "capabilities": ["rwa", "kyc", "custody", "identity"],
  "required_inputs": {
    "type": "object",
    "properties": {
      "customer_id": { "type": "string" },
      "asset_type": { "type": "string" },
      "kyc_provider_id": {
        "type": "string",
        "description": "Registry id of a KYC-provider knowledge base. Discover one with tenzro_listKnowledge."
      },
      "custody_tool_id": {
        "type": "string",
        "description": "Registry id of a custody tool exposing a bind_custody operation. Discover one with tenzro_listTools."
      }
    },
    "required": ["customer_id", "asset_type", "kyc_provider_id", "custody_tool_id"]
  },
  "expected_outputs": {
    "type": "object",
    "properties": {
      "kyc": { "type": "object" },
      "identity": {
        "type": "object",
        "properties": {
          "did": { "type": "string" },
          "identity_type": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "custody": { "type": "object" }
    }
  },
  "steps": [
    {
      "kind": "use_knowledge",
      "knowledge_id": "{{ inputs.kyc_provider_id }}",
      "params": { "customer_id": "{{ inputs.customer_id }}" },
      "output_as": "kyc"
    },
    {
      "kind": "use_tool",
      "tool_id": "tool-identity-register",
      "tool_name": "register_identity",
      "params": {
        "identity_type": "human",
        "display_name": "{{ steps.kyc.output.legal_name }}"
      },
      "output_as": "identity"
    },
    {
      "kind": "use_tool",
      "tool_id": "{{ inputs.custody_tool_id }}",
      "tool_name": "bind_custody",
      "params": {
        "did": "{{ steps.identity.output.did }}",
        "asset_type": "{{ inputs.asset_type }}"
      },
      "output_as": "custody"
    }
  ]
}
