{
  "name": "canton-settlement",
  "version": "1.0.0",
  "description": "AP2 mandate → multi-party Canton DAML create → settlement receipt. Demonstrates bounded autonomous write to Canton.",
  "category": "settlement",
  "capabilities": ["canton", "settlement", "ap2"],
  "required_inputs": {
    "type": "object",
    "properties": {
      "counterparty_party_fq": { "type": "string" },
      "amulet_amount": { "type": "string" },
      "memo": { "type": "string" },
      "checkout_vdc": {
        "type": "object",
        "description": "Signed AP2 CheckoutMandate VDC. Produced by the controller's wallet — a template cannot carry a signature, so it is supplied at instantiation."
      },
      "payment_vdc": {
        "type": "object",
        "description": "Signed AP2 PaymentMandate VDC, bound to checkout_vdc via checkout_hash."
      }
    },
    "required": [
      "counterparty_party_fq",
      "amulet_amount",
      "checkout_vdc",
      "payment_vdc"
    ]
  },
  "expected_outputs": {
    "type": "object",
    "properties": {
      "receipt": {
        "type": "object",
        "properties": {
          "ap2_receipt": { "type": "object" },
          "canton_receipt": { "type": "object" }
        }
      }
    }
  },
  "steps": [
    {
      "kind": "use_tool",
      "tool_id": "tool-canton-submit-mandate",
      "tool_name": "submit_with_mandate",
      "params": {
        "command_type": "create",
        "template_id": "#Splice.AmuletRules:AmuletRules:Transfer",
        "create_arguments": {
          "to": "{{ inputs.counterparty_party_fq }}",
          "amount": "{{ inputs.amulet_amount }}",
          "memo": "{{ inputs.memo }}"
        },
        "mandate": {
          "checkout": "{{ inputs.checkout_vdc }}",
          "payment": "{{ inputs.payment_vdc }}"
        }
      },
      "output_as": "receipt"
    }
  ]
}
