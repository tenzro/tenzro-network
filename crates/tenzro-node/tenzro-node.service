[Unit]
Description=Tenzro Network Node
After=network.target
Documentation=https://github.com/tenzro/tenzro-network

[Service]
Type=simple
User=tenzro
Group=tenzro
WorkingDirectory=/var/lib/tenzro
ExecStart=/usr/local/bin/tenzro-node \
  --config /etc/tenzro/config.json \
  --data-dir /var/lib/tenzro/data \
  --log-level info

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tenzro
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
LimitNOFILE=65536
MemoryMax=8G

# Restart policy
Restart=on-failure
RestartSec=10s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tenzro-node

[Install]
WantedBy=multi-user.target
