# CUDA image variant. Builds tenzro-node with GPU acceleration:
#   - llama.cpp CUDA backend for LLM inference (feature `tenzro-node/cuda`)
#   - ONNX Runtime CUDA execution provider for the non-LLM modalities
#     (feature `tenzro-node/onnx-cuda`; forecast / vision / text-embedding /
#     segmentation / detection / audio runtimes)
#
# Builds on both x86_64 and aarch64 (Grace-Blackwell GB10 / DGX Spark, Grace
# Hopper GH200, Jetson Thor). The base images are multi-arch, so `docker build`
# on the target machine picks the matching one with no extra flags.
#
# On aarch64 the ONNX Runtime CUDA build is compiled from source in a separate
# stage — neither Microsoft nor pyke publishes a GPU distribution for that
# architecture. Expect roughly an extra hour and ~60 GB of RAM for that stage;
# see the ort-cuda stage below.
#
# Run with the NVIDIA container runtime: `docker run --gpus all ...`
# The CPU image is built from ./Dockerfile and is unchanged by this file.

ARG CUDA_VERSION=13.0.3
ARG UBUNTU_VERSION=ubuntu24.04

# Stage 0: ONNX Runtime with the CUDA execution provider, aarch64 only.
#
# pyke's `ort` binary distribution carries a `cu12` feature set for
# x86_64-unknown-linux-gnu only; for aarch64 it publishes a CPU-only build.
# ort-sys does not treat that as an error — it logs that the requested feature
# set is unavailable and downloads the CPU build instead, so enabling
# `ort/cuda` on aarch64 without this stage yields a binary that compiles,
# advertises CUDA, and silently executes on the CPU. Microsoft publishes no
# aarch64 GPU tarball or `onnxruntime-gpu` wheel either, so the runtime is
# compiled here and handed to ort-sys via ORT_LIB_LOCATION.
#
# On x86_64 the stage produces an empty prefix and exits immediately; the
# pyke cu12 distribution is used there as before.
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-${UBUNTU_VERSION} AS ort-cuda

# CUDA 13.0 is the first toolkit to carry sm_121 (GB10). 90 = Grace Hopper
# GH200, 110 = Jetson Thor (renumbered from SM101 in CUDA 13.0), 121 = GB10 /
# DGX Spark. Jetson Orin (sm_87) is deliberately absent: NVIDIA keeps Orin on
# the CUDA 12.x JetPack line rather than the unified CUDA 13 Arm target.
# Every additional architecture costs build time, so trim this for a
# single-target machine.
ARG ORT_CUDA_ARCHITECTURES="90;110;121"
# Pinned to the release NVIDIA's own DGX Spark build guide validates against
# CUDA 13.0 + cuDNN 9 on Ubuntu 24.04. ONNX Runtime below 1.24.4 does not
# compile against CUDA 13 at all.
ARG ONNXRUNTIME_VERSION=v1.24.4

# --parallel is 4 rather than $(nproc) on purpose: the CUDA kernel and
# flash-attention translation units each hold tens of GB, and compiling them
# at full width exhausts memory on a 128 GB machine.
RUN set -eux; \
    mkdir -p /opt/onnxruntime/lib; \
    if [ "$(uname -m)" != "aarch64" ]; then exit 0; fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates git wget ninja-build g++ gcc make \
      python3 python3-pip python3-dev; \
    rm -rf /var/lib/apt/lists/*; \
    pip3 install --break-system-packages --no-cache-dir \
      cmake psutil setuptools wheel packaging; \
    git clone --depth 1 --branch "$ONNXRUNTIME_VERSION" --recursive \
      https://github.com/microsoft/onnxruntime /src/onnxruntime; \
    cd /src/onnxruntime; \
    ./build.sh \
      --config Release \
      --use_cuda \
      --cuda_home /usr/local/cuda \
      --cudnn_home /usr \
      --build_shared_lib \
      --skip_tests \
      --allow_running_as_root \
      --parallel 4 \
      --cmake_extra_defines \
        "CMAKE_CUDA_ARCHITECTURES=${ORT_CUDA_ARCHITECTURES}" \
        CMAKE_INSTALL_LIBDIR=lib; \
    cmake --install build/Linux/Release --prefix /opt/onnxruntime; \
    cp build/Linux/Release/libonnxruntime_providers_shared.so /opt/onnxruntime/lib/; \
    ls -l /opt/onnxruntime/lib; \
    test -f /opt/onnxruntime/lib/libonnxruntime.so; \
    test -f /opt/onnxruntime/lib/libonnxruntime_providers_cuda.so; \
    test -f /opt/onnxruntime/lib/libonnxruntime_providers_shared.so; \
    rm -rf /src/onnxruntime

# Stage 1: Build
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-${UBUNTU_VERSION} AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libclang-dev \
    clang \
    cmake \
    protobuf-compiler \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain (the workspace rust-toolchain.toml selects the channel;
# rustup syncs it on the first cargo invocation)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH=/root/.cargo/bin:$PATH

# Empty on x86_64, a full CUDA-enabled ONNX Runtime prefix on aarch64.
COPY --from=ort-cuda /opt/onnxruntime /opt/onnxruntime

WORKDIR /build

# Force clang as the C/C++ compiler (required by llama-cpp-sys-2 which uses
# clang-specific flags). nvcc keeps g++ as its host compiler via CUDAHOSTCXX —
# clang is not a supported nvcc host compiler on every CUDA 12.x minor.
ENV CC=clang
ENV CXX=clang++
ENV CUDAHOSTCXX=g++

# CUDAARCHS is deliberately unset. ggml picks the architecture list itself when
# CMAKE_CUDA_ARCHITECTURES is undefined (ggml/src/ggml-cuda/CMakeLists.txt),
# covering Turing through Blackwell and appending 121a-real on CUDA >= 12.9 —
# the compute capability of GB10, which no hand-written list here would carry.
# It only falls back to the unusable "native" when GGML_NATIVE is ON, and
# llama-cpp-sys-2 sets that OFF unless the Rust target-cpu is native.

# Copy workspace files
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/
COPY tools/ tools/
# vendor/* subtrees (erc8004-evm, erc8004-solana, erc8004-daml, erc8004-atom)
# are source artifacts for regenerate.sh / DAML compilation, not build-time
# dependencies — they're copied here because COPY vendor/ is a single layer
# and the cost is negligible vs. surgical sub-copies.
COPY vendor/ vendor/

# Create minimal stub for desktop app workspace member (not built, but cargo needs it to resolve workspace)
# The real Cargo.toml is excluded by .gcloudignore (apps/), so we generate a stub inline
# NOTE: Cannot use shell heredocs here — Docker's classic parser interprets each line as a
# Dockerfile instruction, so [package] would be parsed as unknown instruction [PACKAGE].
RUN mkdir -p apps/tenzro-desktop/src-tauri/src && \
    echo "fn main() {}" > apps/tenzro-desktop/src-tauri/src/main.rs && \
    echo "fn main() {}" > apps/tenzro-desktop/src-tauri/build.rs && \
    printf '%s\n' \
      '[package]' \
      'name = "tenzro-desktop"' \
      'version = "0.1.0"' \
      'edition = "2021"' \
      '' \
      '[build-dependencies]' \
      'tauri-build = { version = "2", features = [] }' \
      '' \
      '[dependencies]' \
      'tauri = { version = "2", features = ["tray-icon"] }' \
      'tauri-plugin-shell = "2"' \
      'serde = { version = "1", features = ["derive"] }' \
      'serde_json = "1"' \
      'tokio = { version = "1", features = ["full"] }' \
      'reqwest = { version = "0.12", features = ["json", "stream"] }' \
      'futures-util = "0.3"' \
      'thiserror = "2"' \
      'tracing = "0.1"' \
      'uuid = { version = "1", features = ["v4"] }' \
      'hex = "0.4"' \
      'dirs = "5"' \
      'sysinfo = "0.31"' \
      'sha2 = "0.10"' \
      'aes-gcm = "0.10"' \
      'rand = "0.8"' \
      'hostname = "0.4"' \
      'tenzro-model = { path = "../../../crates/tenzro-model" }' \
      'tenzro-zk = { path = "../../../crates/tenzro-zk" }' \
      '' \
      '[features]' \
      'default = ["custom-protocol"]' \
      'custom-protocol = ["tauri/custom-protocol"]' \
      > apps/tenzro-desktop/src-tauri/Cargo.toml

# Build tenzro-node (llama.cpp CUDA + ONNX Runtime CUDA EP) and tenzro-cli.
#
# On x86_64, ort-sys with the `cuda` feature downloads the cu12 ONNX Runtime
# dist at build time (network required, same as the CPU image's
# download-binaries). On aarch64, ORT_LIB_LOCATION points ort-sys at the
# prefix the ort-cuda stage compiled; ort-sys checks that variable before the
# download path, and ORT_SKIP_DOWNLOAD makes the precedence explicit rather
# than incidental. That link is dynamic and ort-sys emits no rpath of its own,
# so one is set here pointing at where the runtime stage lands the libraries.
# Either way the CUDA execution provider is compiled in, so forecast / vision /
# text-embedding / segmentation / detection / audio run on the GPU alongside
# LLM inference.
RUN set -eux; \
    if [ "$(uname -m)" = "aarch64" ]; then \
      export ORT_LIB_LOCATION=/opt/onnxruntime; \
      export ORT_SKIP_DOWNLOAD=1; \
      export RUSTFLAGS="-C link-arg=-Wl,-rpath,/usr/local/lib/onnxruntime"; \
    fi; \
    cargo build --release -p tenzro-node -p tenzro-cli \
      --features "tenzro-node/cuda,tenzro-node/onnx-cuda"

# The `rpc` feature (on by default via cluster-serving) builds the standalone
# ggml `rpc-server` binary into llama-cpp-sys-2's cargo OUT_DIR. That path does
# not survive into the runtime stage, so stage it at a fixed location for COPY.
# The final ldd guard fails the build if rpc-server links a ggml/llama shared
# object. CUDA libraries are expected dynamic links here: libcudart/libcublas
# resolve from the runtime image, and libcuda.so.1 is the driver library the
# NVIDIA container runtime injects at `docker run --gpus all` — it is absent in
# the build container, so it is excluded from the not-found check.
RUN set -eux; \
    src="$(find target/release/build -type f -name rpc-server -perm -u+x 2>/dev/null | head -n1)"; \
    test -n "$src"; \
    cp "$src" /build/rpc-server; \
    ldd /build/rpc-server || true; \
    ! ldd /build/rpc-server | grep -v 'libcuda\.so\.1' | grep -qiE 'libggml|libllama|not found'

# Stage 2: Runtime
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-runtime-${UBUNTU_VERSION} AS runtime

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3t64 \
    curl \
    libstdc++6 \
    libgomp1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r tenzro && useradd -r -g tenzro -m -d /home/tenzro tenzro

# Copy binaries from builder
COPY --from=builder /build/target/release/tenzro-node /usr/local/bin/tenzro-node
COPY --from=builder /build/target/release/tenzro /usr/local/bin/tenzro-cli
# ggml rpc-server sidecar for LAN cluster serving; the node resolves it via
# TENZRO_RPC_SERVER_BIN (overrides the compile-time OUT_DIR path that the
# multi-stage build discards).
COPY --from=builder /build/rpc-server /usr/local/bin/rpc-server
ENV TENZRO_RPC_SERVER_BIN=/usr/local/bin/rpc-server

# aarch64 links ONNX Runtime dynamically against the prefix built in the
# ort-cuda stage, resolved through the rpath baked in during the build. The
# CUDA and shared-provider objects must sit in the same directory as
# libonnxruntime.so — ONNX Runtime dlopens them relative to its own load path,
# and its docs advise against putting them on a library search path. The
# directory is empty on x86_64, where ONNX Runtime is linked statically out of
# the pyke distribution.
COPY --from=ort-cuda /opt/onnxruntime/lib /usr/local/lib/onnxruntime

# Create data directories
RUN mkdir -p /data/tenzro /config /home/tenzro/.tenzro/models && chown -R tenzro:tenzro /data /config /home/tenzro/.tenzro

USER tenzro
WORKDIR /home/tenzro

# Expose ports
# P2P, JSON-RPC, Web API, Metrics, MCP, A2A
EXPOSE 9000 8545 8080 9090 3001 3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/verify/health || exit 1

# Default entrypoint
ENTRYPOINT ["tenzro-node"]

# Default args (override with docker run args)
CMD ["--data-dir", "/data/tenzro", "--log-level", "info"]
