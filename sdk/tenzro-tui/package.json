{
  "name": "tenzro-tui",
  "version": "0.2.2",
  "private": true,
  "description": "Interactive terminal console for a Tenzro node and wallet, built on tenzro-sdk",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "tenzro-tui": "dist/src/cli.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && FORCE_COLOR=3 node --test --test-timeout=120000 --test-force-exit dist/test/*.test.js"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "tenzro-sdk": "file:../tenzro-ts-sdk"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
