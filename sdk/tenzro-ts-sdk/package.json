{
  "name": "tenzro-sdk",
  "version": "0.9.0",
  "description": "Tenzro Network SDK: the core and every capability package (payments, settlement, agents, bridge, inference, chain) in one import",
  "keywords": [
    "blockchain",
    "ai",
    "agents",
    "mcp",
    "web3",
    "tenzro",
    "defi"
  ],
  "homepage": "https://tenzro.com/docs/sdk",
  "bugs": {
    "url": "https://github.com/tenzro/tenzro-network/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenzro/tenzro-network.git",
    "directory": "sdk/tenzro-ts-sdk"
  },
  "license": "Apache-2.0",
  "author": "Tenzro <eng@tenzro.com>",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "API.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "packages/core",
    "packages/payments",
    "packages/settlement",
    "packages/agents",
    "packages/bridge",
    "packages/inference",
    "packages/chain"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepare": "tsc -b",
    "test": "tsc -b && tsc -p tsconfig.examples.json && node --test test/*.test.cjs && node scripts/gen-api.cjs --check",
    "prepublishOnly": "npm test",
    "docs": "node scripts/gen-api.cjs"
  },
  "dependencies": {
    "@tenzro/core": "0.9.0",
    "@tenzro/payments": "0.9.0",
    "@tenzro/settlement": "0.9.0",
    "@tenzro/agents": "0.9.0",
    "@tenzro/bridge": "0.9.0",
    "@tenzro/inference": "0.9.0",
    "@tenzro/chain": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
