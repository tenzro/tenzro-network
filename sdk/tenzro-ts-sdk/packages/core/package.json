{
  "name": "@tenzro/core",
  "version": "0.9.0",
  "description": "Tenzro Network SDK core: the node client, types, the hardware signer interface and typed transaction builders",
  "keywords": [
    "tenzro",
    "tenzro-sdk",
    "client",
    "transactions",
    "hardware-signer"
  ],
  "homepage": "https://tenzro.com/docs/sdk",
  "bugs": {
    "url": "https://github.com/tenzro/tenzro-network/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenzro/tenzro-network.git",
    "directory": "sdk/tenzro-ts-sdk/packages/core"
  },
  "license": "Apache-2.0",
  "author": "Tenzro <eng@tenzro.com>",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "node -e \"require('fs').accessSync('dist/index.js')\""
  },
  "peerDependencies": {
    "@tenzro/device-key": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@tenzro/device-key": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
