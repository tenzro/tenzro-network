# Tenzro Network Node — Environment Variables
# Copy to .env and fill in your values

# ─── Required for Production ─────────────────────────────────────────────────

# dRPC API key for paid RPC access to external chains (Ethereum, Solana, etc.)
# Get one at https://drpc.org
DRPC_API_KEY=

# ─── Auth: OAuth 2.1 + DPoP (RFC 9449 / RFC 9396) ────────────────────────────

# Bearer JWT minted by tenzro_onboardHuman / tenzro_onboardDelegatedAgent /
# tenzro_onboardAutonomousAgent. SDK clients and the CLI forward this as the
# `Authorization: DPoP <jwt>` header on every authenticated RPC call.
TENZRO_BEARER_JWT=

# Per-request DPoP proof (JWS-compact, RFC 9449). Bound to the JWT's cnf.jkt
# (RFC 7638 thumbprint). Required alongside TENZRO_BEARER_JWT for write RPCs.
TENZRO_DPOP_PROOF=

# ─── MCP Authentication ──────────────────────────────────────────────────────

# MCP auth mode: "tiered" (default), "full", or "false" (disable auth)
# tiered = read-only tools public; write tools require a DPoP-bound bearer JWT
# full   = all tools require a DPoP-bound bearer JWT
# false  = no auth (development/testnet only)
TENZRO_MCP_AUTH=tiered

# ─── External Chain RPCs ─────────────────────────────────────────────────────

# Override default RPC URLs for ecosystem MCP servers
# If not set, uses dRPC with DRPC_API_KEY, or public fallback RPCs
ETHEREUM_RPC_URL=
SOLANA_RPC_URL=

# Helius API key for enhanced Solana RPC (optional)
HELIUS_API_KEY=

# Override the RPC endpoint used by the Chainlink CCT pool registry
TENZRO_CCT_RPC_URL=

# ─── Canton / DAML (Enterprise) ──────────────────────────────────────────────

# Enable Canton DAML integration
CANTON_ENABLED=false
CANTON_LEDGER_API_HOST=localhost
CANTON_LEDGER_API_PORT=7575

# ─── deBridge ────────────────────────────────────────────────────────────────

# Override deBridge MCP endpoint (default: https://agents.debridge.com/mcp)
DEBRIDGE_MCP_URL=

# ─── TEE Simulation ─────────────────────────────────────────────────────────

# Set to "1" to simulate TEE hardware when real hardware is not available
# Only use for development/testing — production nodes must have real TEE
TENZRO_SIMULATE_TDX=0
TENZRO_SIMULATE_SEV=0
TENZRO_SIMULATE_SEV_SNP=0
TENZRO_SIMULATE_NITRO=0
TENZRO_SIMULATE_GPU=0

# ─── CLI ─────────────────────────────────────────────────────────────────────

# Suppress the ASCII banner on CLI startup
TENZRO_NO_BANNER=0
