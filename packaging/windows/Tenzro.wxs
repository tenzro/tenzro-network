<?xml version="1.0" encoding="utf-8"?>
<!--
  Tenzro Windows installer (WiX Toolset v4).

  Repackages the release binaries unchanged. Nothing is started, no service is
  installed, and nothing joins a network at install time.

  Required defines (passed by build-msi.ps1):
    Version       product version, for example 0.2.0
    ProductCode   GUID, stable for a given version
    PayloadDir    directory holding bin\tenzro.exe and bin\tenzro-node.exe

  The libraries beside the programs and the network profiles differ from
  archive to archive: build-msi.ps1 writes their components (the groups
  PayloadLibs and NetworkProfiles) and compiles them with this file.
    StageDir      directory holding LICENSE.txt, NOTICE.txt, PROVENANCE.txt, License.rtf
    ScriptDir     directory holding the scripts from this folder
    Compression   cab compression level: low, medium or high
    SourceCommit, PublicCommit, ArchiveSha256   recorded as MSI properties

  Public properties for command-line installs:
    INSTALLFOLDER   install location (default: %ProgramFiles%\Tenzro)
    ADDTOPATH       system | user | none   (default: system, or the previous
                    choice when upgrading)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Tenzro"
           Manufacturer="Tenzro"
           Version="$(Version)"
           ProductCode="$(ProductCode)"
           UpgradeCode="6B1E5A52-3C0D-4F0B-9C5E-7A1D2F8B4E91"
           Scope="perMachine"
           Language="1033"
           InstallerVersion="500">

    <SummaryInformation Description="Tenzro command line and node (CUDA build)" Keywords="Tenzro" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Tenzro is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="$(Compression)" />

    <!-- Add/Remove Programs -->
    <Property Id="ARPCOMMENTS" Value="Tenzro command line and node, CUDA build. Installs no service and starts nothing." />
    <Property Id="ARPURLINFOABOUT" Value="https://tenzro.com" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Provenance, visible in the Property table -->
    <Property Id="TENZRO_SOURCE_COMMIT" Value="$(SourceCommit)" />
    <Property Id="TENZRO_PUBLIC_COMMIT" Value="$(PublicCommit)" />
    <Property Id="TENZRO_ARCHIVE_SHA256" Value="$(ArchiveSha256)" />

    <!-- PATH choice: system | user | none -->
    <Property Id="ADDTOPATH" Secure="yes" />
    <Property Id="ADDTOPATH_PREV" Secure="yes">
      <RegistrySearch Id="PrevAddToPath" Root="HKLM" Key="SOFTWARE\Tenzro\Installer" Name="AddToPath" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SetAddToPathPrev" Id="ADDTOPATH" Value="[ADDTOPATH_PREV]" After="AppSearch" Sequence="both" Condition="ADDTOPATH = &quot;&quot; AND ADDTOPATH_PREV &lt;&gt; &quot;&quot;" />
    <SetProperty Action="SetAddToPathDefault" Id="ADDTOPATH" Value="system" After="AppSearch" Sequence="both" Condition="ADDTOPATH = &quot;&quot; AND ADDTOPATH_PREV = &quot;&quot;" />
    <Launch Condition="REMOVE=&quot;ALL&quot; OR ADDTOPATH~=&quot;system&quot; OR ADDTOPATH~=&quot;user&quot; OR ADDTOPATH~=&quot;none&quot;"
            Message="ADDTOPATH must be system, user or none." />

    <Launch Condition="VersionNT64" Message="Tenzro requires 64-bit Windows." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Tenzro">
        <Directory Id="BINDIR" Name="bin" />
        <Directory Id="SHAREDIR" Name="share">
          <Directory Id="NETWORKDIR" Name="network" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="Tenzro" />
    </StandardDirectory>

    <!-- Working directory for shortcuts: the invoking user's profile -->
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="USERPROFILEDIR" />
    </StandardDirectory>
    <SetDirectory Id="USERPROFILEDIR" Value="[%USERPROFILE]" Sequence="both" />

    <!-- Files -->
    <ComponentGroup Id="BinFiles" Directory="BINDIR">
      <Component Id="CmpTenzroExe" Bitness="always64">
        <File Id="TenzroExe" Source="$(PayloadDir)\bin\tenzro.exe" KeyPath="yes" />
      </Component>
      <Component Id="CmpTenzroNodeExe" Bitness="always64">
        <File Id="TenzroNodeExe" Source="$(PayloadDir)\bin\tenzro-node.exe" KeyPath="yes" />
      </Component>
      <Component Id="CmpCheckCmd" Bitness="always64">
        <File Id="TenzroCheckCmd" Source="$(ScriptDir)\tenzro-check.cmd" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="RootFiles" Directory="INSTALLFOLDER">
      <Component Id="CmpLicense" Bitness="always64">
        <File Id="LicenseTxt" Source="$(StageDir)\LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Id="CmpNotice" Bitness="always64">
        <File Id="NoticeTxt" Source="$(StageDir)\NOTICE.txt" KeyPath="yes" />
      </Component>
      <Component Id="CmpProvenance" Bitness="always64">
        <File Id="ProvenanceTxt" Source="$(StageDir)\PROVENANCE.txt" KeyPath="yes" />
      </Component>
      <Component Id="CmpCheckPs1" Bitness="always64">
        <File Id="CheckPs1" Source="$(ScriptDir)\tenzro-check.ps1" KeyPath="yes" />
      </Component>
      <Component Id="CmpTerminalCmd" Bitness="always64">
        <File Id="TerminalCmd" Source="$(ScriptDir)\tenzro-terminal.cmd" KeyPath="yes" />
      </Component>
      <Component Id="CmpRegistry" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tenzro\Installer" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tenzro\Installer" Name="Version" Type="string" Value="$(Version)" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tenzro\Installer" Name="AddToPath" Type="string" Value="[ADDTOPATH]" />
      </Component>
    </ComponentGroup>

    <!-- Shortcuts -->
    <ComponentGroup Id="Shortcuts" Directory="StartMenuDir">
      <Component Id="CmpShortcuts" Bitness="always64">
        <Shortcut Id="ScTenzro" Name="Tenzro" Description="Open a terminal running tenzro"
                  Target="[System64Folder]cmd.exe" Arguments="/c &quot;&quot;[INSTALLFOLDER]tenzro-terminal.cmd&quot; menu&quot;"
                  WorkingDirectory="USERPROFILEDIR" Show="minimized" />
        <Shortcut Id="ScSetup" Name="Tenzro setup" Description="Run the hardware check, then tenzro setup"
                  Target="[System64Folder]cmd.exe" Arguments="/c &quot;&quot;[INSTALLFOLDER]tenzro-terminal.cmd&quot; setup&quot;"
                  WorkingDirectory="USERPROFILEDIR" Show="minimized" />
        <Shortcut Id="ScCheck" Name="Tenzro hardware check" Description="Check this machine (changes nothing)"
                  Target="[System64Folder]cmd.exe" Arguments="/c &quot;&quot;[INSTALLFOLDER]tenzro-terminal.cmd&quot; check&quot;"
                  WorkingDirectory="USERPROFILEDIR" Show="minimized" />
        <Shortcut Id="ScUninstall" Name="Uninstall Tenzro" Description="Remove Tenzro from this computer"
                  Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RmStartMenuDir" Directory="StartMenuDir" On="uninstall" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tenzro\Installer" Name="Shortcuts" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- PATH entries; exactly one of these is selected by ADDTOPATH -->
    <ComponentGroup Id="PathSystemGroup" Directory="INSTALLFOLDER">
      <Component Id="CmpPathSystem" Bitness="always64">
        <Environment Id="EnvPathSystem" Name="PATH" Action="set" Part="last" Permanent="no" System="yes" Value="[INSTALLFOLDER]bin" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tenzro\Installer" Name="PathSystem" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="PathUserGroup" Directory="INSTALLFOLDER">
      <Component Id="CmpPathUser" Bitness="always64">
        <Environment Id="EnvPathUser" Name="PATH" Action="set" Part="last" Permanent="no" System="no" Value="[INSTALLFOLDER]bin" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tenzro\Installer" Name="PathUser" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Tenzro" Level="1" AllowAbsent="no" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="BinFiles" />
      <ComponentGroupRef Id="PayloadLibs" />
      <ComponentGroupRef Id="NetworkProfiles" />
      <ComponentGroupRef Id="RootFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
    <Feature Id="PathSystem" Title="Add Tenzro to the system PATH" Level="0" Display="hidden">
      <Level Value="1" Condition="ADDTOPATH~=&quot;system&quot;" />
      <ComponentGroupRef Id="PathSystemGroup" />
    </Feature>
    <Feature Id="PathUser" Title="Add Tenzro to the user PATH" Level="0" Display="hidden">
      <Level Value="1" Condition="ADDTOPATH~=&quot;user&quot;" />
      <ComponentGroupRef Id="PathUserGroup" />
    </Feature>

    <!-- Wizard -->
    <WixVariable Id="WixUILicenseRtf" Value="$(StageDir)\License.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Run Tenzro setup now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Tenzro is installed. Nothing has been started and nothing has joined any network. Setup first checks this machine (the check changes nothing), then walks you through your first-run choices. You can run the check again any time from the Start menu (Tenzro hardware check) or by typing tenzro-check." />

    <CustomAction Id="LaunchSetup" Directory="INSTALLFOLDER" Impersonate="yes" Execute="immediate" Return="asyncNoWait"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c &quot;&quot;[INSTALLFOLDER]tenzro-terminal.cmd&quot; setup&quot;" />

    <UI Id="TenzroUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <UIRef Id="WixUI_Common" />
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="LicenseAgreementDlg" />
      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="ExitDialog" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="InvalidDirDlg" />

      <Dialog Id="PathDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose where the tenzro command is available." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Add Tenzro to PATH" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Intro" Type="Text" X="20" Y="58" Width="330" Height="30" NoPrefix="yes"
                 Text="Adding Tenzro to PATH lets you type tenzro in any new terminal window. The installer adds exactly one folder (the bin folder of the install location) and removes it again on uninstall." />
        <Control Id="PathChoice" Type="RadioButtonGroup" X="20" Y="96" Width="330" Height="90" Property="ADDTOPATH">
          <RadioButtonGroup Property="ADDTOPATH">
            <RadioButton Value="system" X="0" Y="0" Width="330" Height="18" Text="Add Tenzro to the system PATH (all users, recommended)" />
            <RadioButton Value="user" X="0" Y="24" Width="330" Height="18" Text="Add Tenzro to my user PATH only" />
            <RadioButton Value="none" X="0" Y="48" Width="330" Height="18" Text="Do not change PATH (use the Start menu shortcuts)" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Note" Type="Text" X="20" Y="192" Width="330" Height="30" NoPrefix="yes"
                 Text="Already open terminal windows keep their old PATH; open a new one after installing." />
      </Dialog>

      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_X64" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSetup" Order="998" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_X64" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="PathDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="PathDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="PathDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="PathDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

    </UI>

    <UIRef Id="WixUI_ErrorProgressText" />
    <CustomActionRef Id="WixUIValidatePath_X64" />
    <CustomActionRef Id="WixUIPrintEula_X64" />

  </Package>
</Wix>
